{
  "name": "vivy-nest-admin",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "haiweilian <haiweilian@foxmail.com>",
  "homepage": "https://github.com/haiweilian/vivy-nest-admin",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "commit": "cz",
    "lint:lint-staged": "lint-staged",
    "lint:eslint": "eslint --fix --cache \"**/*.{js,jsx,ts,tsx,vue}\"",
    "lint:stylelint": "stylelint --fix --cache \"**/*.{css,scss,less,styl}\"",
    "lint:prettier": "prettier --write \"**/*.{css,scss,less,styl,js,jsx,ts,tsx,vue}\"",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "build": "pnpm build:common && pnpm --recursive --stream build",
    "build:common": "pnpm --filter=@vivy-common/** build",
    "test": "pnpm build:common && vitest run",
    "test:watch": "pnpm build:common && vitest",
    "test:cov": "pnpm build:common && vitest run --coverage",
    "test:e2e": "pnpm build:common && vitest run --config vitest.config.e2e.ts",
    "test:typecheck": "pnpm build:common && tsc --project tsconfig.spec.json",
    "docker:rm": "docker-compose rm",
    "docker:stop": "docker-compose stop",
    "docker:base": "docker-compose up -d"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/bull": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/typeorm": "^12.0.3",
    "@vivy-common/config": "workspace:*",
    "@vivy-common/core": "workspace:*",
    "@vivy-common/datascope": "workspace:^",
    "@vivy-common/excel": "workspace:*",
    "@vivy-common/logger": "workspace:*",
    "@vivy-common/mybatis": "workspace:*",
    "@vivy-common/security": "workspace:*",
    "@vivy-common/swagger": "workspace:*",
    "axios": "^1.21.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "lodash": "^4.18.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nestjs-typeorm-paginate": "^4.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@internal/eslint-config": "workspace:*",
    "@internal/stylelint-config": "workspace:*",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "commitizen": "^4.3.2",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "supertest": "7.3.2",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
